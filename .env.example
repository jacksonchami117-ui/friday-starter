# FRIDAY System Configuration

# Core Settings
SECRET_KEY=your-secret-key-here
DATA_DIR=./state
PORT=5000
SAFE_MODE=0

# Database Configuration  
USE_DB=1

# Notifications
NOTIFICATIONS_ENABLED=1
EMAIL_PROVIDER=smtp
SMS_PROVIDER=twilio

# SMTP Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=1

# SendGrid Configuration (alternative to SMTP)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE=+1234567890

# AWS SNS Configuration (alternative to Twilio)  
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# Legacy settings (for existing deployments)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/friday
META_VERIFY_TOKEN=testtoken
